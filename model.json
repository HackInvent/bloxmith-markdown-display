{
  "kind": "markdown_display",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Markdown viewer",
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "md",
        "title": "Markdown",
        "accepts": [
          "text/markdown",
          "text/plain",
          "message/*",
          "application/json"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": []
  },
  "config": {},
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "display_node": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_modal.css"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ]
  }
}
